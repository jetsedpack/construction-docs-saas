flowchart TD
    A["Исходные документы + фактические сведения"] --> B["Разбор, версия и источник каждого сведения"]
    B --> C["Маскирование/минимизация доступа для ИИ"]
    C --> D["ИИ сопоставляет РД, сметы, факты, НТД/НПА"]
    D --> E{"Есть конфликт или нехватка оснований?"}
    E -- "Да" --> F["Предложение ИИ + ссылки на источники"]
    F --> G["ПТО проверяет первичные данные"]
    G --> H{"Исправление или обоснованное исключение?"}
    H -- "Правка данных/документа" --> I["Согласованная правка и её обоснование"]
    I --> J["Контроль допустимости записи"]
    H -- "Исключение" --> K["Фиксация решения и основания"]
    E -- "Нет" --> J
    K --> J
    J --> L[("Версионный реестр ИД и связанных данных")]
    L --> M["Проверка комплектности"]
    M --> N{"ПТО подтверждает готовность?"}
    N -- "Нет" --> G
    N -- "Да" --> O["Формирование комплекта, экспорт, архив"]
