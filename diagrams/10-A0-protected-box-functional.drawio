rounded=0;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#F7F3EE;strokeColor=#F7F3EE;strokeWidth=0;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="1700" as="geometry"/></mxCell><mxCell id="mark" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#67D6EF;strokeColor=#67D6EF;strokeWidth=0;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="46" width="9" height="85" as="geometry"/></mxCell><mxCell id="h" value="A0  /  КАК РАБОТАЕТ СИСТЕМА ИД" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=34;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="87" y="45" width="1760" height="67" as="geometry"/></mxCell><mxCell id="kicker" value="Изолированная «коробка» первична; ИИ взаимодействует с ней через шлюз; финальная приёмка — у ПТО" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=18;fontColor=#65747D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="87" y="113" width="1930" height="34" as="geometry"/></mxCell><mxCell id="version" value="ФУНКЦИОНАЛЬНАЯ МОДЕЛЬ  ·  18.11.2026" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#E8ECE9;strokeColor=#E8ECE9;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2020" y="57" width="496" height="57" as="geometry"/></mxCell><mxCell id="inputs" value="ВНЕШНИЙ ПАКЕТ ОБЪЕКТА&#xa;РД, ТЗ, ТУ, сметы, сертификаты, журналы,&#xa;акты, протоколы ПНР, фактические данные" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#EFF1F1;strokeColor=#AEBCC2;strokeWidth=1.5;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="208" width="565" height="132" as="geometry"/></mxCell><mxCell id="outside" value="ИСТОЧНИКИ НПА/НТД&#xa;Официальные публикации, реестры,&#xa;правовые справочные системы (по правам доступа)" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FCF6E4;strokeColor=#D6BD75;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="208" width="660" height="132" as="geometry"/></mxCell><mxCell id="pto" value="ИНЖЕНЕР ПТО  /  WINDOWS&#xa;Диалог с ИИ по вопросам; проверка и утверждение&#xa;только финального комплекта документов" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#F0F6E9;strokeColor=#8BB896;strokeWidth=1.5;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1990" y="1318" width="516" height="155" as="geometry"/></mxCell><mxCell id="box" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#ECF2F0;strokeColor=#4F8382;strokeWidth=4;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="65" y="377" width="1725" height="1210" as="geometry"/></mxCell><mxCell id="box_heading" value="ИЗОЛИРОВАННАЯ «КОРОБКА»  ·  ПОСТОЯННАЯ СИСТЕМА" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#334D57;strokeColor=#334D57;strokeWidth=1.5;fontFamily=Arial;fontSize=24;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="92" y="394" width="1663" height="69" as="geometry"/></mxCell><mxCell id="box_descr" value="Предзаданные правила, формы и таблицы; закрытый архив; рабочие версии; аудиторский след. Всё состояние объекта хранится здесь." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#567077;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="108" y="472" width="1590" height="43" as="geometry"/></mxCell><mxCell id="raw" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FDFCFB;strokeColor=#B9A6C2;strokeWidth=2.4;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="554" width="483" height="314" as="geometry"/></mxCell><mxCell id="raw_title" value="01  ·  ЗАКРЫТЫЙ АППЕНДИКС" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#EAE5F0;strokeColor=#EAE5F0;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="571" width="457" height="58" as="geometry"/></mxCell><mxCell id="raw_text" value="Оригиналы входящих документов&#xa;• Файлы и исходные версии&#xa;• Чувствительные реквизиты&#xa;• Извлечённый текст / таблицы&#xa;• Метки источника и контроль полноты" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="136" y="646" width="424" height="193" as="geometry"/></mxCell><mxCell id="norm" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FFFDF6;strokeColor=#D1B878;strokeWidth=2.4;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652" y="554" width="483" height="314" as="geometry"/></mxCell><mxCell id="norm_title" value="02  ·  НОРМАТИВЫ И ПРАВИЛА" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#F5EBCB;strokeColor=#F5EBCB;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="666" y="571" width="455" height="58" as="geometry"/></mxCell><mxCell id="norm_text" value="НПА / НТД и редакции&#xa;• Область и сроки действия&#xa;• Правила составления ИД&#xa;• Версии форм и шаблонов&#xa;• Дата последнего успешного обновления" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="681" y="645" width="424" height="190" as="geometry"/></mxCell><mxCell id="templates" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FCFDFB;strokeColor=#93BD9F;strokeWidth=2.4;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1197" y="554" width="544" height="314" as="geometry"/></mxCell><mxCell id="templates_title" value="03  ·  ТАБЛИЧНАЯ МОДЕЛЬ ИД" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#DCF0E0;strokeColor=#DCF0E0;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1211" y="571" width="517" height="58" as="geometry"/></mxCell><mxCell id="templates_text" value="Заранее существующая структура&#xa;• Работы, материалы, исполнители&#xa;• Документы, акты, реестры&#xa;• Ссылки и обязательные поля&#xa;• Шаблоны для выходных документов" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1228" y="647" width="483" height="191" as="geometry"/></mxCell><mxCell id="aliases" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FDFCFB;strokeColor=#C1A6CC;strokeWidth=2.3;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="930" width="483" height="260" as="geometry"/></mxCell><mxCell id="aliases_head" value="04  ·  СЛОВАРЬ ШИФРОВОК" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#EAE5F0;strokeColor=#EAE5F0;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="946" width="457" height="55" as="geometry"/></mxCell><mxCell id="aliases_text" value="ИП Иванов ⇄ ИП 1849&#xa;Сопоставления реальных реквизитов&#xa;и локальных псевдонимов.&#xa;Ключи обратного преобразования&#xa;НЕ передаются на GPUGO." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="138" y="1022" width="426" height="153" as="geometry"/></mxCell><mxCell id="quality" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FDFDFC;strokeColor=#A4BFD0;strokeWidth=2.3;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652" y="930" width="483" height="260" as="geometry"/></mxCell><mxCell id="quality_head" value="05  ·  КОНТРОЛЬ ОБЪЁМА" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#E4EFF6;strokeColor=#E4EFF6;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="667" y="946" width="454" height="55" as="geometry"/></mxCell><mxCell id="quality_text" value="Обработано / не разобрано&#xa;Сверка правил, связей и версий&#xa;Повторные проходы по ошибкам&#xa;Непроверенные участки явно&#xa;попадают в итоговый отчёт." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="686" y="1021" width="413" height="155" as="geometry"/></mxCell><mxCell id="stage" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#F8FCFE;strokeColor=#8FBBCD;strokeWidth=2.7;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1197" y="930" width="544" height="260" as="geometry"/></mxCell><mxCell id="stage_head" value="06  ·  ПРОМЕЖУТОЧНАЯ ВЕРСИЯ" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#D9EBF4;strokeColor=#D9EBF4;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1212" y="946" width="516" height="55" as="geometry"/></mxCell><mxCell id="stage_text" value="ИИ формирует рабочую ИД по правилам&#xa;• Заполненные таблицы и черновики&#xa;• Исправления, обнаруженные различия&#xa;• История итераций и вопросов ПТО&#xa;• Не меняет исходные оригиналы" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1225" y="1020" width="478" height="155" as="geometry"/></mxCell><mxCell id="deliver" value="07  ·  ИТОГОВЫЙ КОМПЛЕКТ&#xa;Документы + приложения + реестр + журнал проверок&#xa;Проверка полноты, расшифровка псевдонимов, формирование вывода" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#E1F4E2;strokeColor=#8DB996;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1334" width="822" height="142" as="geometry"/></mxCell><mxCell id="gateway" value="ШЛЮЗ&#xa;• разрешённый контекст&#xa;• псевдонимы&#xa;• возврат изменений&#xa;• проверка ответа" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FCEAE1;strokeColor=#E3AC92;strokeWidth=2.7;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1757" y="804" width="206" height="305" as="geometry"/></mxCell><mxCell id="gpubox" value="" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FFF8F0;strokeColor=#DEA987;strokeWidth=2.5;fontFamily=Arial;fontSize=16;fontColor=#1A1C1D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2010" y="472" width="488" height="755" as="geometry"/></mxCell><mxCell id="gputitle" value="ИИ НА СЕРВЕРАХ GPUGO" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#F4D9C9;strokeColor=#F4D9C9;strokeWidth=1.5;fontFamily=Arial;fontSize=21;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2028" y="491" width="453" height="69" as="geometry"/></mxCell><mxCell id="gpu_analyze" value="АНАЛИЗ ИСХОДНЫХ СВЕДЕНИЙ&#xa;Структура, несостыковки, ошибки,&#xa;полнота охвата исходного пакета" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FFFFFF;strokeColor=#E5BAA7;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2032" y="598" width="445" height="144" as="geometry"/></mxCell><mxCell id="gpu_draft" value="СОСТАВЛЕНИЕ ИД&#xa;Подгонка по правилам и формам,&#xa;повторные проходы с проверками" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FFFFFF;strokeColor=#E5BAA7;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2032" y="771" width="445" height="135" as="geometry"/></mxCell><mxCell id="gpu_norms" value="ОБНОВЛЕНИЕ НПА / НТД&#xa;Поиск изменений в источниках,&#xa;структурированный проект обновления" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FFFFFF;strokeColor=#E5BAA7;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2032" y="934" width="445" height="133" as="geometry"/></mxCell><mxCell id="gpu_qa" value="ОТВЕТЫ НА ВОПРОСЫ ПТО&#xa;Естественный язык в шифровках;&#xa;модель не видит закрытого словаря" style="rounded=1;arcSize=13;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fillColor=#FFFFFF;strokeColor=#E5BAA7;strokeWidt