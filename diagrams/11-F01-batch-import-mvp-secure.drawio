lor=none;fontFamily=Arial;fontSize=21;fontColor=#304B56;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="210" width="2070" height="83" as="geometry"/></mxCell><mxCell id="mvph" value="MVP · БЫСТРЫЙ ПИЛОТНЫЙ КОНТУР" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#DAEDF4;strokeColor=#A7CBD7;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="344" width="1000" height="86" as="geometry"/></mxCell><mxCell id="secureh" value="УСИЛЕННЫЙ ЗАЩИЩЁННЫЙ КОНТУР" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#E8E2F0;strokeColor=#BEAFD0;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1175" y="344" width="1000" height="86" as="geometry"/></mxCell><mxCell id="MVP_1" value="Импорт папки / нескольких файлов&#xa;исходные байты шифруются локально" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#ECF7FA;strokeColor=#B9D8E4;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="94" y="480" width="938" height="115" as="geometry"/></mxCell><mxCell id="MVP_2" value="Тип выбирается отдельно для каждого файла&#xa;начальный ограниченный справочник типов" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#ECF7FA;strokeColor=#B9D8E4;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="94" y="635" width="938" height="115" as="geometry"/></mxCell><mxCell id="MVP_3" value="Локальные PDF / DOCX / XLSX / CSV&#xa;остальные форматы заблокированы для AI" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#ECF7FA;strokeColor=#B9D8E4;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="94" y="790" width="938" height="115" as="geometry"/></mxCell><mxCell id="MVP_4" value="Whitelist полей + псевдонимы&#xa;небезопасный фрагмент не отправляется" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#ECF7FA;strokeColor=#B9D8E4;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="94" y="945" width="938" height="115" as="geometry"/></mxCell><mxCell id="MVP_5" value="Безопасный структурный JSON, версионирование,&#xa;ручной контроль неполных случаев" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#ECF7FA;strokeColor=#B9D8E4;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="94" y="1100" width="938" height="115" as="geometry"/></mxCell><mxCell id="SEC_1" value="Всё из MVP + проверка вложений, сканов,&#xa;метаданных, скрытых листов и изображений" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#F2EDF7;strokeColor=#C6B7D9;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1204" y="480" width="938" height="115" as="geometry"/></mxCell><mxCell id="SEC_2" value="Профили парсинга и политик на весь каталог&#xa;с контролем версий и области применения" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#F2EDF7;strokeColor=#C6B7D9;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1204" y="635" width="938" height="115" as="geometry"/></mxCell><mxCell id="SEC_3" value="Песочница для опасных файлов, OCR локально,&#xa;лимиты времени, памяти и распаковки" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#F2EDF7;strokeColor=#C6B7D9;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1204" y="790" width="938" height="115" as="geometry"/></mxCell><mxCell id="SEC_4" value="Контроль косвенной реидентификации,&#xa;защита alias-словаря и прав доступа" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#F2EDF7;strokeColor=#C6B7D9;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1204" y="945" width="938" height="115" as="geometry"/></mxCell><mxCell id="SEC_5" value="Поэлементный coverage и provenance,&#xa;аудит, серверная валидация, тесты утечек" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#F2EDF7;strokeColor=#C6B7D9;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1204" y="1100" width="938" height="115" as="geometry"/></mxCell><mxCell id="out" value="В ОБОИХ РЕЖИМАХ: НЕПРОВЕРЕННЫЙ ФРАГМЕНТ НЕ МОЖЕТ БЕЗУСЛОВНО ПОПАСТЬ НА GPUGO" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=13;spacingRight=13;spacingTop=8;spacingBottom=8;fillColor=#FFF1E7;strokeColor=#DDB99D;strokeWidth=2;fontFamily=Arial;fontSize=22;fontColor=#1A1C1D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1317" width="2105" height="109" as="geometry"/></mxCell><mxCell id="foot" value="PoC-код сегодня не реализует ни полноценный MVP F01, ни усиленный режим. Сначала необходима реализация и тестирование на синтетических примерах." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontColor=#69767B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="75" y="1450" width="2050" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>