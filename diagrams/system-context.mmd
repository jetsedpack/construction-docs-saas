flowchart TB
    subgraph INPUT["Источники строительных данных"]
      TZ["ТЗ / ТУ"]
      RD["РД / чертежи / спецификации"]
      SSR["ССР / сметные данные"]
      FACTS["Фактические сведения / документы контроля"]
    end
    INPUT --> GW["Контролируемый шлюз: разбор, минимизация, псевдонимизация"]
    GW --> AI["ИИ-аналитик: сопоставление, пропуски, конфликты, предложения"]
    AI --> VAL["Валидация предложений и связей"]
    VAL --> BOX[("Изолированная коробка: реестр ИД + связанные сведения + правила")]
    NORM["НПА / НТД / формы: проверенные редакции"] --> BOX
    BOX -. "разрешённый контекст" .-> GW
    BOX --> PTO["ПТО: проверка и утверждение"]
    PTO --> BOX
    BOX --> OUT["Реестр, акты, схемы, журналы, комплект ИД, архив"]
