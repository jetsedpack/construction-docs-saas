ТЬ В POC&#xa;Листы / страницы /&#xa;пересечения / графы" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="406" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="v_future" value="СЛЕДУЮЩИЙ ЭТАП&#xa;РД↔акт, паспорт↔&#xa;материал, монтаж↔ПНР" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="746" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="v_rule" value="ПРАВИЛО&#xa;ID + версия +&#xa;основание + дата" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1086" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="v_issue" value="03.6  ·  FINDING&#xa;Observed / expected /&#xa;source / severity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="v_ok" value="03.7  ·  ДАЛЬШЕ&#xa;Проверить состав&#xa;комплекта F06" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;stro