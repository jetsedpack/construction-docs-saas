7D6EF;" vertex="1" parent="1"><mxGeometry x="57" y="45" width="9" height="78" as="geometry"/></mxCell><mxCell id="head" value="F04  /  БЕЗОПАСНЫЙ АНАЛИЗ ЧЕРЕЗ GPUGO" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#1A1C1D;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="85" y="45" width="1800" height="54" as="geometry"/></mxCell><mxCell id="subtitle" value="Две независимые проверки допустимого payload; модель выдаёт только неподтверждённую рекомендацию." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#66717A;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="87" y="108" width="1840" height="40" as="geometry"/></mxCell><mxCell id="legend" value="ЗЕЛЁНЫЙ — POC КОД       ГОЛУБОЙ — ЧАСТИЧНО       ПЕРСИКОВЫЙ — ЗАПЛАНИРОВАНО       РОМБ — УСЛОВИЕ" style="rounded=1;arcSize=8;fillColor=#E9EBE8;strokeColor=#E2E3E0;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#293B43;" vertex="1" parent="1"><mxGeometry x="68" y="175" width="1960" height="45" as="geometry"/></mxCell><mxCell id="g0" value="04.1  ·  ПТО&#xa;Выбрать находки,&#xa;запросить AI" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="66" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="g1" value="04.2  ·  ALLOWLIST&#xa;category + severity&#xa;+ numeric metrics" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="406" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="g2" value="04.3  ·  PREVIEW&#xa;Показать JSON,&#xa;endpoint и риск" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="746" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="g3" value="СОГЛАСИЕ?&#xa;&#xa;Отправить только&#xa;проверенные поля" style="rhombuswhiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF9E8;strokeColor=#D9BA65;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1086" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="g4" value="04.4  ·  HTTPS&#xa;TLS / bearer /&#xa;timeout / no redirect" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="g5" value="04.5  ·  EDGE&#xa;Повторная проверка&#xa;schema и model" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1766" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="g_off" value="ОТМЕНА&#xa;Работа локально.&#xa;Нет отправки." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1086" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="g_error" value="401 / 429 / 502&#xa;Нет автоматической&#xa;правки в базе" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="g_gpu" value="04.6  ·  LLM&#xa;vLLM на GPUGO&#xa;4×6000D (план)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1766" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="g_response" value="04.7  ·  VALIDATE&#xa;JSON index/action/&#xa;rationale, лимиты" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#DFF1E6;strokeColor=#71AB8A;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1766" y="728" width="286" height="142" as="geometry"/></mxCell><mxCell id="g_pto" value="04.8  ·  РЕШЕНИЕ&#xa;Рекомендация ПТО,&#xa;не утверждённый факт" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="728" width="286" height="142" as="geometry"/></mxCell><mxCell id="g_foot" value="ГРАНИЦА ВОЗМОЖНОСТЕЙ&#xa;Сейчас GPUGO не получает РД, акты, заводские номера, схемы и свободный текст. AI умеет только объяснять абстрактное замечание. Содержательное сравнение документов потребует отдельно согласованной, проверенной политики передачи структурированных данных." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="65" y="1020" width="1962" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f05" name="F05  /  РАБОЧИЙ ПРОЦЕСС ИНЖЕНЕРА ПТО"><mxGraphModel dx="2100" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1270" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f05_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;fontSize=14;fontColor=#293B43;labelBackgroundColor=#F7F3EE;" edge="1" parent="1" source="h0" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f05_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;fontSize=14;fontColor=#293B43;labelBackgroundColor=#F7F3EE;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f05_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;