"/></mxCell><mxCell id="o_foot" value="СТАТУС И ОГРАНИЧЕНИЕ&#xa;Этот контур пока проектируется. Нельзя считать сформированную AI форму подписанным актом, протоколом испытаний или документом о фактическом выполнении работ. КС-2, АОСР и ПНР имеют разное назначение." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="65" y="1020" width="1962" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f07" name="F07  /  ОБНОВЛЕНИЕ НПА, НТД И ПРАВИЛ"><mxGraphModel dx="2100" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1270" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f07_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;fontSize=14;fontColor=#293B43;labelBackgroundColor=#F7F3EE;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f07_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;fontSize=14;fontColor=#293B43;labelBackgroundColor=#F7F3EE;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f07_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0;ent