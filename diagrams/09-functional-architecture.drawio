488" width="286" height="142" as="geometry"/></mxCell><mxCell id="v_pto" value="ВЫХОД В F05&#xa;ПТО видит замечание&#xa;и основание" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="728" width="286" height="142" as="geometry"/></mxCell><mxCell id="v_foot" value="ПРИМЕР ПРОВЕРКИ ЧГЭС&#xa;В реестре задано «3 листа», страницы «4–7»: локальная арифметика даёт 4 страницы. Система отмечает несоответствие на проверку; отсутствие пути к файлу фиксирует информационно, не как доказанное нарушение." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="65" y="1020" width="1962" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f04" name="F04  /  БЕЗОПАСНЫЙ АНАЛИЗ ЧЕРЕЗ GPUGO"><mxGraphModel dx="2100" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1270" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f04_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;endArrow=block;endFill=1;dashed=0;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Arial;fontSize=14;fontColor=#293B43;labelBackgroundColor=#F7F3EE;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f04_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=24;html=0;strokeColor=#7D9AA1;strokeWidth=2.3;e