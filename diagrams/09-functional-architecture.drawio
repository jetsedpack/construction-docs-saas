keColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="406" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="x2" value="F02  ·  CLAIMS&#xa;planned_length=20,&#xa;actual_length=33" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="746" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="x3" value="F03  ·  СВЕРКА&#xa;33 ≠ 20; найти&#xa;основание изменения" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1086" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="x4" value="ЕСТЬ&#xa;СОГЛАСОВАНИЕ?&#xa;&#xa;Акт/ведомость/письмо,&#xa;номер, дата, роль" style="rhombuswhiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF9E8;strokeColor=#D9BA65;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="x5" value="F05  ·  ПТО&#xa;Сверить оригиналы,&#xa;дать решение" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1766" y="248" width="286" height="142" as="geometry"/></mxCell><mxCell id="x_rule" value="НОРМЫ + ПРОЕКТ&#xa;Что действовало на&#xa;дату исполнения" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="746" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="x_missing" value="НЕ НАЙДЕНО&#xa;Не «незаконно», а&#xa;«проверь согласование»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="x_approved" value="ПОДТВЕРЖДЕНО&#xa;Изменение содержит&#xa;ссылку на основание" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1766" y="488" width="286" height="142" as="geometry"/></mxCell><mxCell id="x_doc" value="F06  ·  РЕЗУЛЬТАТ&#xa;Реестр ИД: корректная&#xa;версия + комплект" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1426" y="728" width="286" height="142" as="geometry"/></mxCell><mxCell id="x_trace" value="ПРОСЛЕЖИВАЕМОСТЬ&#xa;Document → Claim →&#xa;WorkItem → Review" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;fillColor=#FFF0E0;strokeColor=#D6AE80;strokeWidth=2;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="1766" y="728" width="286" height="142" as="geometry"/></mxCell><mxCell id="x_foot" value="ЗАЧЕМ ЗДЕСЬ AI&#xa;Арифметика и поиск ссылки должны работать детерминированно локально. AI уместен там, где данные неполны или нужно объяснить обнаруженное замечание, но он не может выдумать фактическую длину, согласование, акт или юридическую силу документа." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=10;spacingBottom=8;fillColor=#E2F1F8;strokeColor=#78B6CD;strokeWidth=2;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1A1C1D;" vertex="1" parent="1"><mxGeometry x="65" y="1020" width="1962" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>