{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpugo.example.invalid/schema/structured-packet/0.1",
  "title": "Approved structured content for GPUGO AI analysis — draft contract",
  "description": "Shape validation only. Does NOT grant permission to transmit arbitrary string values; separate content/metadata policy is mandatory. Synthetic schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "template",
    "documents",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "draft-0.1"
    },
    "task": {
      "enum": [
        "extract",
        "compare",
        "reconcile_and_compose",
        "ask",
        "normative_update"
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "version"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,60}$"
        },
        "version": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_total",
        "files_processed",
        "files_blocked",
        "fields_total",
        "fields_exported"
      ],
      "properties": {
        "files_total": {
          "type": "integer",
          "minimum": 1
        },
        "files_processed": {
          "type": "integer",
          "minimum": 0
        },
        "files_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "fields_total": {
          "type": "integer",
          "minimum": 0
        },
        "fields_exported": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_type",
        "format",
        "profile_version",
        "metadata",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DOC-[0-9]{1,6}$"
        },
        "document_type": {
          "type": "string",
          "pattern": "^[a-z_]{3,60}$"
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "xlsx",
            "csv",
            "dwg",
            "other"
          ]
        },
        "profile_version": {
          "type": "string",
          "maxLength": 32
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "sheet_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "revision": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            },
            "extraction_version": {
              "type": "string",
              "maxLength": 32
            },
            "layout_kind": {
              "enum": [
                "pages",
                "sheets",
                "paragraphs",
                "mixed",
                "unknown"
              ]
            }
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "value_kind",
        "value",
        "location",
        "origin_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{1,8}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z_]{2,70}$"
        },
        "value_kind": {
          "enum": [
            "number",
            "boolean",
            "safe_enum",
            "alias",
            "placeholder",
            "missing"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 512
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "origin_ref": {
          "type": "string",
          "pattern": "^SRC-[0-9]{1,8}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sheet_index": {
          "type": "integer",
          "minimum": 1
        },
        "cell": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
        },
        "block_id": {
          "type": "integer",
          "minimum": 0
        },
        "bbox_normalized": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "type": "string",
          "maxLength": 32
        },
        "to": {
          "type": "string",
          "maxLength": 32
        },
        "kind": {
          "enum": [
            "same_entity",
            "depends_on",
            "compares_with",
            "evidence_for",
            "part_of",
            "references"
          ]
        }
      }
    }
  }
}
